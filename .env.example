# OpenAI-совместимый endpoint и модель
OPENAI_API_KEY=YOUR_OPEN_API_KEY
# Для обычного API укажи базовый URL только если провайдер его требует
# OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_MODEL=gpt-6.1-sol

# Для Ollama: OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen3.5:4b
# Для qwen3.5:4b выключаем рассуждения, чтобы ускорить CPU-прогон
# OPENAI_REASONING_EFFORT=none
